[Unit]
Description=CNF — Cluster Nova Federation Agent
Documentation=https://github.com/your-org/OpenStack_NCF
After=network-online.target libvirtd.service
Wants=network-online.target
Requires=libvirtd.service

[Service]
Type=simple
User=cnf
Group=cnf
EnvironmentFile=-/etc/cnf/cnf.env
ExecStart=/usr/local/bin/cnf-agent
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/cnf /var/lib/cnf
ReadOnlyPaths=/etc/cnf /etc/ceph

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cnf-agent

[Install]
WantedBy=multi-user.target
